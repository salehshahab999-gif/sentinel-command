# Sentinel Command Center environment template
# Copy to .env.local and set real values locally.

NESHAN_API_KEY=

# Public/browser-reachable URL of the PDF translation Worker.
NEXT_PUBLIC_PDF_TRANSLATOR_URL=http://localhost:11009

# Same secret must exist in Sentinel and translet-worker.
# Replace this default before any public deployment.
PDF_TRANSLATOR_SHARED_SECRET=sentinel-translet-local-dev-secret
