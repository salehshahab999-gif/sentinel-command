generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scan {
  id        String   @id
  targetId  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Target {
  id        String   @id
  name      String
  address   String?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id
  email     String
  name      String?
  createdAt DateTime @default(now())
}

model Alert {
  id          String         @id
  eventId     String
  severity    String
  status      String
  source      String
  type        String
  title       String
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  history     AlertHistory[]
}

model AlertHistory {
  id        String   @id
  alertId   String
  action    String
  timestamp DateTime @default(now())
  severity  String
  status    String
  source    String
  message   String
  data      Json?
  alert     Alert    @relation(fields: [alertId], references: [id])
}

model NetworkIncident {
  id                         String   @id
  name                       String
  startedAt                  DateTime
  endedAt                    DateTime?
  phase                      String
  severity                   String

  globalReachabilityPercent  Float?
  domesticReachabilityPercent Float?

  affectedTargets            Int
  criticalFailures           Int

  signals                    Json
  notes                      Json

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
