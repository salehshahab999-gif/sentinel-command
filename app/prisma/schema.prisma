generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "cockroachdb"
}

model Scan {
  id        String   @id
  targetId  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Target {
  id        String   @id
  name      String
  address   String?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id
  email     String
  name      String?
  createdAt DateTime @default(now())
}
