# ==========================================
# Sentinel Command Center - Git Ignore
# ==========================================

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build/

# Runtime / Application Logs
/logs/**/*.log
/logs/**/latest*
/logs/**/runtime*

# Temporary / Runtime data
*.tmp
*.temp
*.cache
*.pid
*.lock

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Environment / Secrets
.env
.env.*
!.env.example

# Testing / Coverage
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# Vercel
.vercel/

# Temporary editor files
*.swp
*.swo
*.bak
*.old

# Local development artifacts
*.local